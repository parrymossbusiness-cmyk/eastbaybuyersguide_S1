  <!-- LEAD CAPTURE MODAL (Lead Magnet Gate) -->
  <div id="lead-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-brandNavy border border-slate-700 w-full max-w-md rounded-2xl p-6 sm:p-8 relative shadow-2xl">
      <button onclick="closeLeadGate()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-xl">&times;</button>
      
      <div class="text-center">
        <div class="w-12 h-12 bg-brandGold/20 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-brandGold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white">Unlock The Complete 2027 Guide</h3>
        <p class="text-xs text-slate-300 mt-1">Get immediate access to all 8 East Bay city dossiers, full video archives, and the off-market inspection checklist.</p>
      </div>

      <form id="lead-form" onsubmit="handleLeadSubmit(event)" class="mt-6 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">First & Last Name</label>
          <input type="text" required placeholder="Parry Moss" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brandGold">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Primary Email Address</label>
          <input type="email" required placeholder="you@company.com" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brandGold">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Target Move Timeline</label>
          <select class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2.5 text-sm text-white focus:outline-none focus:border-brandGold">
            <option>Ready to tour within 30 days</option>
            <option>1 to 3 months</option>
            <option>3 to 6 months</option>
            <option>Researching market for 2027</option>
          </select>
        </div>
        <button type="submit" class="w-full bg-brandGold hover:bg-yellow-400 text-brandDark font-black text-sm uppercase tracking-wider py-3.5 rounded-lg shadow-lg transition-transform active:scale-95">
          Access Complete Field Guide
        </button>
      </form>
      <div class="text-center mt-3 text-[11px] text-slate-500">Zero spam. Direct advisory access with Otis White Jr.</div>
    </div>
  </div>

  <!-- JAVASCRIPT DATA ARCHITECTURE -->
  <script>
    // JSON DATA SCHEMA FOR ALL 8 SUBMARKETS
    const EAST_BAY_MARKETS = {
      fairfield: {
        title: "Fairfield Field Guide",
        county: "Solano County",
        badge: "Starter Hub",
        price: "$450K – $550K",
        hoa: "$0 Monthly",
        transit: "I-80 corridor & Capitol Corridor",
        stock: "1940s–50s Bungalows & Ranches",
        youtubeId: "dQw4w9WgXcQ", // Swap with Otis Fairfield YouTube ID
        summary: "Downtown Fairfield along Texas Street delivers walkable access to family-owned dining, coffee shops, and the seasonal farmers' market with zero HOA fees on spacious level lots."
      },
      vallejo: {
        title: "Vallejo Waterfront Guide",
        county: "Solano County",
        badge: "Ferry Gateway",
        price: "$420K – $530K",
        hoa: "$0 – $150/mo",
        transit: "SF Bay Ferry Terminal & I-80",
        stock: "Victorian, Craftsman & Mid-Century",
        youtubeId: "dQw4w9WgXcQ",
        summary: "Historic waterfront community offering direct 60-minute passenger ferry access to downtown SF Ferry Building and some of the region's lowest price-per-square-foot entry points."
      },
      richmond: {
        title: "Richmond & Marina Guide",
        county: "Contra Costa County",
        badge: "Transit Value",
        price: "$520K – $650K",
        hoa: "$0 (Single Family)",
        transit: "Richmond BART & SF Bay Ferry",
        stock: "Post-War Cottages & Waterfront Condos",
        youtubeId: "dQw4w9WgXcQ",
        summary: "Unmatched dual-transit hub offering both terminus BART line access and ferry services to San Francisco, anchored by the Point Richmond historic district and Marina Bay trails."
      },
      berkeley: {
        title: "Berkeley Architectural Guide",
        county: "Alameda County",
        badge: "Prime Academic",
        price: "$850K – $1.4M+",
        hoa: "Varies ($0 SFH)",
        transit: "BART (3 Stations) & AC Transit",
        stock: "Brown Shingle Craftsman & Period Revivals",
        youtubeId: "dQw4w9WgXcQ",
        summary: "World-class cultural and culinary enclave featuring high architectural value, robust long-term equity stability, and mature transit connections into Oakland and downtown SF."
      },
      oakland: {
        title: "Oakland Urban & Metro Guide",
        county: "Alameda County",
        badge: "Urban Center",
        price: "$550K – $950K+",
        hoa: "Neighborhood Dependent",
        transit: "Major BART Hub (12th/19th St) & Ferry",
        stock: "Brooklyn Basin, Grand Lake & Mid-Century",
        youtubeId: "dQw4w9WgXcQ",
        summary: "Dynamic cultural core with high contrast submarkets ranging from newly delivered waterfront developments at Brooklyn Basin to classic Craftsman and Spanish Mediterranean homes."
      },
      alameda: {
        title: "Alameda Island Guide",
        county: "Alameda County",
        badge: "Island Enclave",
        price: "$850K – $1.3M+",
        hoa: "Zero on detached homes",
        transit: "Ferry terminals (Main St & Seaplane Lagoon)",
        stock: "Queen Anne Victorians & Waterfront",
        youtubeId: "dQw4w9WgXcQ",
        summary: "Self-contained island living defined by tree-lined residential streets, top-tier municipal public schools, distinct 25 mph speed regulations, and scenic water recreation."
      },
      antioch: {
        title: "Antioch Delta Gateway",
        county: "Contra Costa County",
        badge: "Maximum Square Feet",
        price: "$500K – $630K",
        hoa: "Minimal to Zero",
        transit: "eBART Extension & CA-4",
        stock: "1980s–2000s 2-Story Subdivisions",
        youtubeId: "dQw4w9WgXcQ",
        summary: "High utility family homes offering large square footage, multi-car garages, and direct connection into central Contra Costa via Highway 4 and the eBART transfer corridor."
      },
      brentwood: {
        title: "Brentwood Agricultural Valley",
        county: "Contra Costa County",
        badge: "Master-Planned",
        price: "$650K – $825K",
        hoa: "$50 – $150/mo",
        transit: "Highway 4 bypass & Vasco Rd",
        stock: "Modern Master-Planned Communities",
        youtubeId: "dQw4w9WgXcQ",
        summary: "Established suburban enclave known for top-rated school clusters, extensive park systems, agricultural open spaces, and modern turnkey single-family housing developments."
      }
    };

    let activeSlug = 'fairfield';

    // RENDER MOBILE CAROUSEL BUTTONS
    function initCarousel() {
      const container = document.getElementById('city-carousel');
      container.innerHTML = Object.keys(EAST_BAY_MARKETS).map(slug => {
        const city = EAST_BAY_MARKETS[slug];
        const isActive = slug === activeSlug;
        return `
          <button onclick="selectCity('${slug}')" id="btn-${slug}" 
            class="px-3.5 py-2 rounded-lg text-xs font-bold whitespace-nowrap border transition-all ${
              isActive 
              ? 'bg-brandGold text-brandDark border-brandGold shadow-md' 
              : 'bg-slate-900 text-slate-300 border-slate-700 hover:border-slate-500'
            }">
            ${slug.charAt(0).toUpperCase() + slug.slice(1)}
          </button>
        `;
      }).join('');
    }

    // UPDATE UI ON CITY SELECTION
    function selectCity(slug) {
      activeSlug = slug;
      const data = EAST_BAY_MARKETS[slug];
      if (!data) return;

      // Update text fields
      document.getElementById('guide-county').innerText = data.county;
      document.getElementById('guide-title').innerText = data.title;
      document.getElementById('guide-badge').innerText = data.badge;
      document.getElementById('guide-price').innerText = data.price;
      document.getElementById('guide-hoa').innerText = data.hoa;
      document.getElementById('guide-transit').innerText = data.transit;
      document.getElementById('guide-stock').innerText = data.stock;
      document.getElementById('guide-summary').innerText = data.summary;
      
      // Update Video
      document.getElementById('video-frame').src = `https://www.youtube.com/embed/${data.youtubeId}?rel=0`;

      // Update Map Active States
      document.querySelectorAll('.city-pin').forEach(el => el.classList.remove('active'));
      const pin = document.getElementById(`pin-${slug}`);
      if (pin) pin.classList.add('active');

      // Update Carousel Buttons
      initCarousel();
    }

    // MODAL LEAD GATE HANDLERS
    function openLeadGate() {
      document.getElementById('lead-modal').classList.remove('hidden');
    }

    function closeLeadGate() {
      document.getElementById('lead-modal').classList.add('hidden');
    }

    function handleLeadSubmit(e) {
      e.preventDefault();
      // Dispatch webhook payload to Google Sheets / Zapier
      alert("Verification successful. Unlocking full dossier and dispatching guide copy to your inbox.");
      closeLeadGate();
      // Optional: window.location.href = `/${activeSlug}/`;
    }

    // INIT ON LOAD
    document.addEventListener('DOMContentLoaded', () => {
      initCarousel();
      selectCity('fairfield');
    });
  </script>
</body>
</html>
