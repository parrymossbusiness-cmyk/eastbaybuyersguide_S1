    <!-- RIGHT: DYNAMIC CITY DOSSIER & VIDEO SHOWCASE (5 COLS) -->
    <div class="lg:col-span-5 bg-brandNavy border border-slate-800 rounded-2xl p-6 shadow-2xl relative">
      <div id="preview-container">
        <!-- HEADER -->
        <div class="flex justify-between items-start border-b border-slate-800 pb-4">
          <div>
            <span id="guide-county" class="text-xs font-bold uppercase tracking-wider text-brandGold">Solano County</span>
